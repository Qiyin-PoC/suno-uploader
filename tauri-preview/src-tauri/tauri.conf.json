{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Qiyin Preview",
  "version": "0.1.0",
  "identifier": "com.qiyin.suno.tauri-preview",
  "plugins": {"updater": {"pubkey": "", "endpoints": []}},
  "build": {"frontendDist": "../ui"},
  "app": {
    "withGlobalTauri": true,
    "windows": [{"label": "main", "title": "期音 · 轻量验证版", "width": 1120, "height": 780, "minWidth": 760, "minHeight": 650}],
    "security": {"csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'"}
  },
  "bundle": {"active": true, "targets": ["app", "dmg"], "resources": {"runtime/": "runtime/"}, "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"], "macOS": {"minimumSystemVersion": "26.0"}}
}
