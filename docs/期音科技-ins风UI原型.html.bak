    <div class="brand" data-page-node-id="8VcF8H2f06UR1bAC4VUMyQ">
      <div class="brand-mark" data-page-node-id="R5rxQuOpyL2rdJ6SFtCWI5"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" data-page-node-id="7MxG3ur3cV1QfQBWNGOFTD"><path d="M9 18V5l12-2v13" data-page-node-id="QzhIzeaIVMgBbNfrop6l3H"/><circle cx="6" cy="18" r="3" fill="#fff" stroke="none" data-page-node-id="jwiMGjF91oRcfScVABbKpg"/><circle cx="18" cy="16" r="3" fill="#fff" stroke="none" data-page-node-id="PfDEDSp5Fq150P1e81T7XY"/></svg></div>
      <div class="brand-copy" data-page-node-id="qFHtQ35jUhEjIuKP98aZAC"><h1 data-page-node-id="D68ZW9qp4pmRIO2KOmlwkr">期音科技</h1><span class="dot" data-page-node-id="NLxUiG2QnmBZL4ftVusfTc">·</span><span class="sub" data-page-node-id="tBOf9Dub9av47TmNaqhdnl">Suno 歌曲上传器</span></div>
    </div>
    <div class="win-tools" data-page-node-id="J3DCDmhQH8VRJC5kMdAl3T">
