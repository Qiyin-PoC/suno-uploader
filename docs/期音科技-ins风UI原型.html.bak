<script>
/* 导航 */
document.querySelectorAll('.nav-item').forEach(item=>{
  item.addEventListener('click',()=>{
    document.querySelectorAll('.nav-item').forEach(n=>n.classList.remove('active'));
    item.classList.add('active');
    document.querySelectorAll('.module-page').forEach(p=>p.classList.remove('active'));
    document.getElementById(item.dataset.panel).classList.add('active');
  });
});

/* 弹窗 */
function openOverlay(id){document.getElementById(id).classList.add('show')}
function closeOverlay(id){document.getElementById(id).classList.remove('show')}
document.querySelectorAll('[data-close]').forEach(b=>b.addEventListener('click',()=>closeOverlay(b.dataset.close)));
document.querySelectorAll('.overlay').forEach(o=>o.addEventListener('click',e=>{if(e.target===o)o.classList.remove('show')}));
document.getElementById('settingsBtn').addEventListener('click',()=>openOverlay('settingsOverlay'));

/* 主题（演示） */
document.querySelectorAll('.theme-choice').forEach(t=>{
  t.addEventListener('click',()=>{
    document.querySelectorAll('.theme-choice').forEach(x=>x.classList.remove('active'));
    t.classList.add('active');
  });
});

/* 登录态 */
let loggedIn = false;
function setLogin(on){
  loggedIn = on;
  document.getElementById('loginBadge').innerHTML = on ? '<span class="dot"></span>已登录' : '<span class="dot"></span>未登录';
  document.getElementById('loginBadge').className = 'badge ' + (on ? 'badge-success' : 'badge-neutral');
  const banner = document.getElementById('loginBanner');
  if(on){
    banner.className = 'login-banner in';
    banner.innerHTML = '<span class="ic"><svg><use href="#i-check"/></svg></span><div class="txt"><strong>已登录 Suno</strong><small>账号：qi***@example.com · 积分充足</small></div><button class="btn btn-ghost btn-sm" id="bannerLogoutBtn">退出登录</button>';
    document.getElementById('bannerLogoutBtn').addEventListener('click',()=>setLogin(false));
  }else{
    banner.className = 'login-banner out';
    banner.innerHTML = '<span class="ic"><svg><use href="#i-key"/></svg></span><div class="txt"><strong>尚未登录 Suno 账号</strong><small>登录后自动抓取会话，上传消耗你自己的积分</small></div><button class="btn btn-primary btn-sm" id="bannerLoginBtn">立即登录</button>';
    document.getElementById('bannerLoginBtn').addEventListener('click',()=>openOverlay('loginOverlay'));
  }
  document.getElementById('accountAvatar').className = on ? 'avatar' : 'avatar guest';
  document.getElementById('accountName').textContent = on ? 'qi***@example.com' : '未登录 Suno';
  document.getElementById('accountMeta').textContent = on ? '积分充足 · 已就绪' : '登录后开始上传';
  document.getElementById('loginBtn').innerHTML = on ? '<span>退出登录</span>' : '<svg><use href="#i-key"/></svg><span>登录 Suno</span>';
  document.getElementById('openResultBtn').disabled = !on;
  document.getElementById('openSegBtn').disabled = !on;
  document.getElementById('clearSegBtn').disabled = !on;
}
document.getElementById('loginBtn').addEventListener('click',()=>{
  if(loggedIn){ setLogin(false); } else { openOverlay('loginOverlay'); }
});
document.getElementById('loginSubmit').addEventListener('click',()=>{
  closeOverlay('loginOverlay');
  setLogin(true);
});

/* 上传模式 */
const speedNotes = {
  stable:'稳定模式质量优先，适合正式翻唱发布。',
  onbeat2x:'快速上传会损失一部分音频质量，但不影响翻唱。'
};
document.querySelectorAll('#speedSeg button').forEach(b=>{
  b.addEventListener('click',()=>{
    document.querySelectorAll('#speedSeg button').forEach(x=>x.classList.remove('active'));
    b.classList.add('active');
    document.getElementById('speedNote').textContent = speedNotes[b.dataset.speed];
  });
});

/* 队列 */
const demoSongs = ['夏日遗憾交给秋天.mp3','画不完的圆.mp3','有光.mp3'];
let demoIdx = 0;
function addQueueItem(name){
  const list = document.getElementById('queueList');
  const empty = list.querySelector('.empty');
  if(empty) empty.remove();
  const item = document.createElement('div');
  item.className = 'q-item';
  item.innerHTML = '<span class="q-ic"><svg><use href="#i-music"/></svg></span><div class="q-main"><div class="q-name">'+name+'</div><div class="q-meta">待上传 · 等待开始</div></div><span class="badge badge-neutral"><span class="dot"></span>待上传</span><button class="q-remove" title="移除"><svg><use href="#i-x"/></svg></button>';
  item.querySelector('.q-remove').addEventListener('click',()=>{
    item.remove();
    updateCount();
    if(list.children.length===0){ list.innerHTML='<div class="empty" style="padding:26px"><div class="e-ic"><svg><use href="#i-music"/></svg></div><strong>队列为空</strong><small>拖入或选择音频开始</small></div>'; }
  });
  list.appendChild(item);
  updateCount();
}
function updateCount(){
  const n = document.querySelectorAll('#queueList .q-item').length;
  document.getElementById('queueCount').textContent = n + ' 首';
}
document.getElementById('dropzone').addEventListener('click',()=>{
  addQueueItem(demoSongs[demoIdx % demoSongs.length]);
  demoIdx++;
});
document.getElementById('clearQueueBtn').addEventListener('click',()=>{
  document.getElementById('queueList').innerHTML = '<div class="empty" style="padding:26px"><div class="e-ic"><svg><use href="#i-music"/></svg></div><strong>队列为空</strong><small>拖入或选择音频开始</small></div>';
  updateCount();
});

/* 上传演示 */
document.getElementById('startBtn').addEventListener('click',()=>{
  if(!loggedIn){ openOverlay('loginOverlay'); return; }
  let p = 0;
  document.getElementById('startBtn').disabled = true;
  document.getElementById('mainStatus').textContent = '上传中...';
  document.getElementById('etaBadge').innerHTML = '预计完成 <b>约 6 分钟</b>';
  const t = setInterval(()=>{
    p = Math.min(100, p + Math.random()*7);
    document.getElementById('progressBar').style.width = p + '%';
    document.getElementById('progressPct').textContent = Math.round(p) + '%';
    const log = document.getElementById('logPanel');
    log.insertAdjacentHTML('beforeend','<div class="l ok"><span class="t">[15:1'+Math.floor(Math.random()*9)+':'+Math.floor(Math.random()*60).toString().padStart(2,'0')+']</span> 切片上传完成 '+Math.round(p)+'%</div>');
    log.scrollTop = log.scrollHeight;
    if(p>=100){
      clearInterval(t);
      document.getElementById('mainStatus').textContent = '上传完成';
      document.getElementById('etaBadge').innerHTML = '已完成';
      document.getElementById('startBtn').disabled = false;
    }
  }, 260);
});

/* 歌词 */
document.getElementById('processLyrics').addEventListener('click',()=>{
  const src = document.getElementById('lyricsInput').value.trim();
  document.getElementById('lyricsOutput').value = src ? '[处理结果]\n' + src.split('\n').map(l=>'· '+l).join('\n') : '请先在上方粘贴歌词';
});
document.getElementById('copyLyrics').addEventListener('click',()=>{
  const out = document.getElementById('lyricsOutput');
  if(out.value){ out.select(); document.execCommand('copy'); }
});

/* MP3 质量 */
document.getElementById('qualityRange').addEventListener('input',e=>{
  document.getElementById('qualityVal').textContent = e.target.value + '（0=最高 · 9=最低）';
});

/* 波形生成 */
function genBars(el, seed, color){
  if(!el) return;
  let html='';
  for(let i=0;i<64;i++){
    const h = 8 + Math.abs(Math.sin(i*0.7+seed)*40) + Math.random()*20;
    html += '<i style="height:'+Math.round(h)+'%;background:'+color+'"></i>';
  }
  el.innerHTML = html;
}
genBars(document.getElementById('vocalWave'), 2, '#a5b4fc');
genBars(document.getElementById('instWave'), 3, '#c4b5fd');

/* 主轨波形 */
const clip = document.getElementById('mainClip');
let clipBars='';
for(let i=0;i<120;i++){ const h=8+Math.abs(Math.sin(i*0.55+1)*40)+Math.random()*18; clipBars+='<i style="flex:1;background:#c4b5fd;border-radius:1px;min-width:1px;height:'+Math.round(h)+'%"></i>'; }
clip.style.display='flex';clip.style.alignItems='center';clip.style.gap='2px';
clip.innerHTML = '<span class="clip-name">夏日遗憾交给秋天</span>'+clipBars;

/* 标尺 */
const ruler = document.getElementById('dawRuler');
let ticks='';
for(let i=0;i<=24;i++){
  const left = (i/24*100);
  const sec = Math.floor(i*9.5);
  ticks += '<span class="tick" style="left:'+left+'%">0:'+String(sec).padStart(2,'0')+'</span>';
}
ruler.innerHTML = ticks;

/* 播放演示 */
let playing = false;
document.getElementById('playBtn').addEventListener('click',()=>{
  playing = !playing;
  const ph = document.getElementById('playhead');
  if(playing){
    document.getElementById('playBtn').innerHTML = '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round"><path d="M8 5v14M16 5v14"/></svg>';
    ph.style.transition = 'left 3s linear';
    ph.style.left = '84%';
  }else{
    document.getElementById('playBtn').innerHTML = '<svg><use href="#i-play"/></svg>';
    ph.style.transition = 'none';
  }
});

/* 历史筛选 chip */
document.querySelectorAll('.chip').forEach(c=>{
  c.addEventListener('click',()=>{
    document.querySelectorAll('.chip').forEach(x=>x.classList.remove('active'));
    c.classList.add('active');
  });
});
</script>
</body>
</html>
