{
  "manifest_version": 3,
  "name": "期音科技 Suno 登录助手",
  "version": "5.0.4",
  "minimum_chrome_version": "120",
  "description": "在用户确认配对后，将当前 Suno 登录状态连接到本机上传器。",
  "permissions": [
    "activeTab",
    "scripting",
    "cookies",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://suno.com/*",
    "https://www.suno.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
