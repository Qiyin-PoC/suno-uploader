QIYIN_DOMAIN=license.your-domain.example
QIYIN_PUBLIC_URL=https://license.your-domain.example
QIYIN_DATABASE=/data/licensing.sqlite3
# Price in fen. Zero disables sales until the owner sets a real price.
QIYIN_PRICE_FEN=0
QIYIN_PLAN_DAYS=30
# Populate approved merchant details on the server. Never put these in Electron.
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_SERIAL=
WECHAT_PRIVATE_KEY_FILE=/run/secrets/wechat-private.pem
WECHAT_API_V3_KEY=
WECHAT_PUBLIC_KEY_ID=
WECHAT_PUBLIC_KEY_FILE=/run/secrets/wechat-public.pem
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY_FILE=/run/secrets/alipay-private.pem
ALIPAY_PUBLIC_KEY_FILE=/run/secrets/alipay-public.pem
ALIPAY_SANDBOX=0
