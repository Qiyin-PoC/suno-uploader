# 依赖
node_modules/

# 打包产物（含 exe，大文件不提交）
dist/

# 内置 Python 运行时（大，不提交）
python-embed/

# 5.0.4 原版 worker EXE（超过 GitHub 单文件限制，随 Release 免安装包发布）
backend/*.exe
backend/*.pyd
backend/__pycache__/
**/__pycache__/
*.pyc

# 内置 ffmpeg（大，不提交）
vendor/ffmpeg/

# 其它大二进制 / 模型 / vendor
vendor/frida/
vendor/kgg/
vendor/qmcwasm/
vendor/um/
vendor/uvr/

# 日志与临时
*.log
*.tmp
*.partial
.part
*.bak
*corrupted_bak
tests/artifacts/

# 系统
.DS_Store
Thumbs.db

# Tauri / Mac 构建产物（体积大，不入库）
tauri-preview/src-tauri/target/
tauri-preview/src-tauri/runtime/
tauri-preview/src-tauri/gen/
tauri-preview/.build/
.venv/

# Electron macOS 打包产物与中间文件（约 500MB，全部可重新生成）
#   build/macos/engine/    PyInstaller 冻结引擎      → scripts/package-macos.js
#   build/macos/icon.icns  由 assets/logo.png 生成    → scripts/package-macos.js
#   build/macos/vendor/    自包含 ffmpeg              → scripts/build-ffmpeg-macos.sh
#   build/macos/*.dmg      安装包
dist-mac/
build/
