{
  "name": "suno-uploader",
  "version": "5.0.4",
  "private": true,
  "description": "期音科技 Suno歌曲上传器（上传、历史、下载）",
  "main": "electron/main/main.js",
  "author": "期音科技",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check-release.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node scripts/run-packaged-e2e.js",
    "pack": "npm test && npm run check && electron-builder --dir && npm run test:e2e",
    "dist": "npm test && npm run check && electron-builder --win zip --x64 && npm run test:e2e",
    "dist:mac": "npm test && npm run check && node scripts/package-macos.js"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.qiyin.suno.uploader",
    "productName": "Suno歌曲上传器",
    "artifactName": "${productName}-V${version}-免安装版.${ext}",
    "asar": true,
    "files": [
      "electron/**/*",
      "!electron/engine/**",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      },
      {
        "from": "backend",
        "to": "backend",
        "filter": ["**/*.py"]
      },
      {
        "from": "python-embed",
        "to": "python-embed"
      },
      {
        "from": "vendor/ffmpeg/win32-x64/ffmpeg.exe",
        "to": "vendor/ffmpeg/win32-x64/ffmpeg.exe"
      },
      {
        "from": "suno-login-extension",
        "to": "suno-login-extension"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": ["x64"]
        }
      ]
    }
  }
}
